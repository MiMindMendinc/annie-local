# Annie Local — environment template
# Copy to .env, then fill every blank secret before starting Compose.
# Safe hex secrets: openssl rand -hex 32

# ── Mode and server ───────────────────────────────────────────────────────────
ANNIE_MODE=production
ANNIE_HOST=0.0.0.0
ANNIE_PORT=8787
ANNIE_DATA_DIR=/data
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# ── Auth (required in production) ────────────────────────────────────────────
AUTH_DISABLED=false
REGISTRATION_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── PostgreSQL (Compose constructs DATABASE_URL from these) ──────────────────
POSTGRES_USER=annie
POSTGRES_PASSWORD=
POSTGRES_DB=annie

# ── Redis (cache, rate limits, worker queue) ──────────────────────────────────
REDIS_PASSWORD=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
WORKER_CONCURRENCY=2

# ── Optional S3-compatible storage service foundation ────────────────────────
# Attachment API/UI is not enabled in v0.3.0.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=annie-uploads
S3_REGION=us-east-1
S3_USE_SSL=false

# ── AI backends ───────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
VOICE_URL=http://host.docker.internal:8123
DEFAULT_MODEL=llama3.2

# ── HTTP retry ────────────────────────────────────────────────────────────────
HTTP_RETRY_ATTEMPTS=4
HTTP_RETRY_BASE_DELAY=0.5

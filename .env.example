# Annie Local — environment template
# Copy to .env and adjust for your deployment.

# ── Mode ──────────────────────────────────────────────────────────────────────
# local       = file-backed, single-user, auth disabled (default `annie launch`)
# production  = PostgreSQL + Redis + JWT + S3 (docker-compose stack)
ANNIE_MODE=production

# ── Server ────────────────────────────────────────────────────────────────────
ANNIE_HOST=0.0.0.0
ANNIE_PORT=8787
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
AUTH_DISABLED=false
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://annie:annie@postgres:5432/annie

# ── Redis (cache + rate limit + worker queue) ─────────────────────────────────
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
WORKER_CONCURRENCY=2

# ── S3 / MinIO (uploads — no local file storage in production) ────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=annie
S3_SECRET_KEY=annie-secret
S3_BUCKET=annie-uploads
S3_REGION=us-east-1
S3_USE_SSL=false

# ── AI backends ───────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
VOICE_URL=http://host.docker.internal:8123
DEFAULT_MODEL=llama3.2

# ── HTTP retry (external API calls) ───────────────────────────────────────────
HTTP_RETRY_ATTEMPTS=4
HTTP_RETRY_BASE_DELAY=0.5
